{
  "name": "dsh-mobile-ui",
  "version": "0.1.0",
  "description": "Mobile UI overlay for the DeepSeek Harness Web GUI: bottom navigation, session drawer, and small-screen panel orchestration as an out-of-tree client plugin (no upstream source changes).",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "link:upstream": "node scripts/link-upstream.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
